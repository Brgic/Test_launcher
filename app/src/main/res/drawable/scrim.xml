<?xml version="1.0" encoding="utf-8"?>
<!-- Abdunklung über dem Hintergrund: oben hell, unten fast schwarz, links etwas dunkler für den Titel -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:centerColor="#8C000000"
                android:centerY="0.45"
                android:endColor="#F7000000"
                android:startColor="#38000000" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="0"
                android:centerColor="#26000000"
                android:endColor="#00000000"
                android:startColor="#A6000000" />
        </shape>
    </item>
</layer-list>
